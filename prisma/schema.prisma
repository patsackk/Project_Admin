generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

// ================= USER (LOGIN) =================
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone     String?
  address   String?
  createdAt DateTime @default(now())

  client  Client? // relation
  history History[]
}

// ================= CLIENT PROFILE =================
model Client {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  location  String
  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id])
}

// ================= PROJECT =================
model Project {
  id       Int    @id @default(autoincrement())
  name     String
  location String

  schedules Schedule[]
  clients   Client[]
}

// ================= WORKER =================
model Worker {
  id   Int    @id @default(autoincrement())
  name String
  team String

  schedules Schedule[]
}

// ================= SCHEDULE =================
model Schedule {
  id        Int      @id @default(autoincrement())
  workerId  Int
  projectId Int
  date      DateTime
  startTime String
  endTime   String

  worker  Worker  @relation(fields: [workerId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
}

// ================= CONTACT =================
model ContactForm {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  message   String
  createdAt DateTime @default(now())

  reply     String?
  repliedAt DateTime?
}

model History {
  id          Int      @id @default(autoincrement())
  userId      Int
  projectName String
  location    String
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
